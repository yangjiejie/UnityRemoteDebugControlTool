<Application x:Class="RemoteDebugServer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 自定义深色主题样式 -->
            </ResourceDictionary.MergedDictionaries>

            <!-- 通用样式 -->
            <Style TargetType="Button" x:Key="ActionButton">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style TargetType="TextBox" x:Key="ModernTextBox">
                <Setter Property="Height" Value="26"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style x:Key="LogTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="Foreground" Value="#E0E0E0"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            </Style>

            <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
            <SolidColorBrush x:Key="BgDark" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="BgMedium" Color="#2D2D30"/>
            <SolidColorBrush x:Key="BgLight" Color="#3C3C3C"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#999"/>
            <SolidColorBrush x:Key="BorderColor" Color="#444"/>
            <SolidColorBrush x:Key="SuccessColor" Color="#4CAF50"/>
            <SolidColorBrush x:Key="ErrorColor" Color="#FF5252"/>
            <SolidColorBrush x:Key="WarningColor" Color="#FFC107"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
