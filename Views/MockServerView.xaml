<UserControl x:Class="RemoteDebugServer.Views.MockServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RemoteDebugServer"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#252526" Foreground="#E0E0E0">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
        <local:BoolStringConverter x:Key="BoolStringConv"/>

        <!-- 暗色下拉框样式：修复弹窗白底白字看不清的问题 -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#333337"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="White"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0078D4"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
            </Style.Resources>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#0078D4"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 发送按钮样式（绿色，显式模板确保颜色可见） -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E9E5B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3CB86C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#247E48"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#4A4A4A"/>
                                <Setter Property="Foreground" Value="#9A9A9A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 重发按钮样式（蓝色） -->
        <Style x:Key="ResendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F8FE0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ScalarEditor">
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                     Width="220" Margin="4,0" Background="#333" Foreground="White"
                     BorderBrush="#555" BorderThickness="1" VerticalContentAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="BoolEditor">
            <CheckBox IsChecked="{Binding Value, Converter={StaticResource BoolStringConv}}"
                      VerticalAlignment="Center" Margin="6,0" Foreground="White"/>
        </DataTemplate>

        <DataTemplate x:Key="EnumEditor">
            <ComboBox ItemsSource="{Binding EnumValues}" SelectedItem="{Binding Value}"
                      Width="170" Margin="4,0"
                      Style="{StaticResource DarkComboBoxStyle}"
                      ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"/>
        </DataTemplate>

        <DataTemplate x:Key="MessageEditor">
            <TextBlock/>
        </DataTemplate>

        <local:ProtoFieldEditorSelector x:Key="EditorSelector"
            ScalarTemplate="{StaticResource ScalarEditor}"
            BoolTemplate="{StaticResource BoolEditor}"
            EnumTemplate="{StaticResource EnumEditor}"
            MessageTemplate="{StaticResource MessageEditor}"/>

        <HierarchicalDataTemplate x:Key="FieldNodeTemplate" ItemsSource="{Binding Items}">
            <StackPanel Orientation="Horizontal" Margin="2,1">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TypeLabel}" Foreground="Gray" FontSize="11" Margin="6,0" VerticalAlignment="Center"/>
                <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource EditorSelector}" VerticalAlignment="Center"/>
                <Button Content="+" Width="22" Height="22" Margin="6,0,0,0"
                        ToolTip="添加元素"
                        Visibility="{Binding IsRepeated, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
                <Button Content="-" Width="22" Height="22" Margin="2,0,0,0"
                        ToolTip="删除元素"
                        Visibility="{Binding Parent, Converter={StaticResource NotNullToVis}}"
                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 协议代码生成：选择 proto 目录 + 一键生成 C# -->
        <StackPanel Grid.Row="0">
            <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="proto 目录:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ProtoGen.ProtoDirectory, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Background="#1E1E1E" Foreground="#E0E0E0" BorderBrush="#444"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="选择目录" Command="{Binding ProtoGen.BrowseProtoDirCommand}"
                            Margin="6,0,0,0" Padding="10,4" Style="{StaticResource SendButtonStyle}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="protoc:" VerticalAlignment="Center" Margin="0,6,6,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProtoGen.ProtocPath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Background="#1E1E1E" Foreground="#E0E0E0" BorderBrush="#444" Margin="0,6,0,0"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="选择 protoc" Command="{Binding ProtoGen.BrowseProtocCommand}"
                            Margin="6,6,0,0" Padding="10,4" Style="{StaticResource SendButtonStyle}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="输出目录:" VerticalAlignment="Center" Margin="0,6,6,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ProtoGen.OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Background="#1E1E1E" Foreground="#E0E0E0" BorderBrush="#444" Margin="0,6,0,0"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="选择目录" Command="{Binding ProtoGen.BrowseOutputDirCommand}"
                            Margin="6,6,0,0" Padding="10,4" Style="{StaticResource SendButtonStyle}"/>

                    <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="⚙ 生成 C# 协议代码"
                            Command="{Binding ProtoGen.GenerateCommand}" Style="{StaticResource SendButtonStyle}"
                            Margin="0,8,6,0" Padding="14,6" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ProtoGen.StatusText}" Margin="6,8,0,0"
                               Foreground="#999" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="520"/>
                </Grid>
            </Border>

            <!-- 顶部：协议选择 + 发送（设备取左侧列表选中项） -->
            <Border Grid.Row="0" Background="#2D2D30" Padding="10,8"
                    BorderBrush="#444" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                <TextBlock Text="协议:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}"
                          DisplayMemberPath="Display" Width="360" Margin="0,0,12,0"
                          Style="{StaticResource DarkComboBoxStyle}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"/>
                <Button Content="▶ 发送" Command="{Binding SendCommand}"
                        Style="{StaticResource SendButtonStyle}"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="#9CDCFE" TextWrapping="Wrap" MaxWidth="460"/>
            </StackPanel>
        </Border>
        </StackPanel>

        <!-- 主体：字段树 + 最近发送 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- 字段树 -->
            <TreeView Grid.Column="0" ItemsSource="{Binding Root.Items}"
                      ItemTemplate="{StaticResource FieldNodeTemplate}"
                      Background="#252526" BorderThickness="0" Margin="4"
                      FontSize="12">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Foreground" Value="#CCC"/>
                        <Setter Property="IsExpanded" Value="True"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          Background="#444" VerticalAlignment="Stretch"/>

            <!-- 最近发送 -->
            <Border Grid.Column="2" Background="#2D2D30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📜 最近发送 (最多100，已存档)" Margin="10,8"
                               FontWeight="SemiBold" FontSize="13"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding SentRequests}"
                             Background="Transparent" BorderThickness="0" Margin="4,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#333" BorderBrush="#444" BorderThickness="1"
                                        CornerRadius="3" Padding="8" Margin="0,2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ProtocolName}" FontWeight="Bold" Foreground="#4FC3F7"/>
                                            <TextBlock Text=" · " Foreground="#888"/>
                                            <TextBlock Text="{Binding TimeText}" Foreground="#888" FontSize="11"/>
                                            <TextBlock Text=" · 已重发" Foreground="#4CAF50" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Resent}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding Summary}" Foreground="#AAA"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2"
                                                   ToolTip="{Binding Base64}"/>
                                        <Button Grid.Row="2" Content="重发" HorizontalAlignment="Left"
                                                Command="{Binding DataContext.ResendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Margin="0,2,0,0"
                                                Style="{StaticResource ResendButtonStyle}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
