<Window x:Class="RemoteDebugServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RemoteDebugServer"
        xmlns:views="clr-namespace:RemoteDebugServer.Views"
        Title="Unity Remote Debug Server"
        Width="1400" Height="850"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#E0E0E0">

    <Window.Resources>
        <!-- 日志颜色转换器 -->
        <local:LogColorConverter x:Key="LogColorConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolConverter x:Key="InverseBool"/>

        <!-- 输入框样式 -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 按钮样式 -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#444"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 只读日志文本框样式 -->
        <Style x:Key="LogTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- RadioButton 深色主题样式 -->
        <Style TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent"
                                Padding="8,4" CornerRadius="3" Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D3D40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设备卡片样式 -->
        <Style x:Key="DeviceCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- ==================== 顶部工具栏 ==================== -->
        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#444" BorderThickness="0,0,0,1" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="UNITY REMOTE DEBUG" FontSize="18" FontWeight="Bold"
                               Foreground="#0078D4" VerticalAlignment="Center" Margin="0,0,20,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="1">
                    <TextBlock Text="本机:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="13"/>
                    <Border Background="#333" BorderBrush="#555" BorderThickness="1"
                            CornerRadius="3" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Text="{Binding LocalIP, Mode=OneWay}" FontSize="13"
                                   Foreground="#4FC3F7" FontFamily="Consolas"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="端口:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="13"/>
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                             Width="70" Style="{StaticResource ModernTextBox}" Margin="0,0,12,0"/>
                    <Border Background="#1A3A1A" CornerRadius="3" Padding="8,4">
                        <TextBlock FontSize="11" Foreground="#81C784" VerticalAlignment="Center">
                            <Run Text="Unity客户端配置: "/>
                            <Run Text="{Binding ConnectionInfo, Mode=OneWay}" FontFamily="Consolas" FontWeight="Bold"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="3">
                    <Button Content="▶ 启动" Command="{Binding StartServerCommand}"
                            IsEnabled="{Binding IsServerStopped}"
                            Background="#4CAF50" Foreground="White" BorderThickness="0"
                            Style="{StaticResource ActionButton}" Width="80"/>
                    <Button Content="■ 停止" Command="{Binding StopServerCommand}"
                            IsEnabled="{Binding IsServerRunning}"
                            Background="#FF5252" Foreground="White" BorderThickness="0"
                            Style="{StaticResource ActionButton}" Width="80"/>
                </StackPanel>

                <Border Grid.Column="5" VerticalAlignment="Center" Padding="10,4"
                        CornerRadius="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#333"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                    <Setter Property="Background" Value="#1B5E20"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="12" Foreground="#E0E0E0"/>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 主体区域 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧面板：设备列表 -->
            <Border Grid.Column="0" Background="#252526">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2D2D30" Padding="12,0"
                            BorderBrush="#444" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📱 已连接设备" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text=" (" Foreground="#999" FontSize="12"/>
                            <TextBlock Text="{Binding Devices.Count, Mode=OneWay}" Foreground="#0078D4" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text=" / N)" Foreground="#999" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- 使用 ListBox 开启 UI 虚拟化，只渲染可视区域内的设备卡片，
                         上百台设备也不卡；自带选中视觉已隐藏，选中高亮由卡片的 IsSelected 触发 -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Devices}"
                             Background="#252526"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Cursor="Hand"
                                        MouseLeftButtonDown="DeviceCard_Click"
                                        CornerRadius="4" Padding="10" Margin="0,2">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource DeviceCardStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#1A3A5C"/>
                                                    <Setter Property="BorderBrush" Value="#0078D4"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBox Text="{Binding Alias, UpdateSourceTrigger=LostFocus}"
                                                 FontSize="14" FontWeight="SemiBold" Foreground="White"
                                                 Background="Transparent" BorderThickness="0"
                                                 Padding="0" Cursor="Arrow"
                                                 ToolTip="点击编辑设备别名，失焦自动保存">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Opacity" Value="0.85"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="Cursor" Value="IBeam"/>
                                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                            <Setter Property="BorderBrush" Value="#4A90D9"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#FF5252"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Fill" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1" FontSize="11" Foreground="#999"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Platform, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding IpAddress, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock FontSize="11" Foreground="#E0E0E0" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="底包"/>
                                            <Run Text="{Binding AppVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="资源版本"/>
                                                <Run Text="{Binding HotUpdateVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock FontSize="10" Foreground="#666"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="Unity "/>
                                            <Run Text="{Binding UnityVersion, Mode=OneWay}"/>
                                            
                                            <Run Text=" · 日志: "/>
                                            <Run Text="{Binding Logs.Count, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空状态提示 -->
                    <TextBlock Grid.Row="1" Text="暂无连接设备&#x0a;启动服务器后等待Unity客户端连接"
                               Foreground="#666" FontSize="14" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDevices}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          Background="#444" VerticalAlignment="Stretch"/>

            <!-- 右侧主面板：日志/场景树 Tab -->
            <Grid Grid.Column="2" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tab 和工具栏 -->
                <Border Grid.Row="0" Background="#2D2D30" Padding="8,4"
                        BorderBrush="#444" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <RadioButton Content="日志" IsChecked="True" Margin="0,0,10,0"
                                         Foreground="White" FontSize="13"
                                         GroupName="MainTab" x:Name="TabLogs"
                                         Checked="TabLogs_Checked"/>
                            <RadioButton Content="场景树" Margin="0,0,10,0"
                                         Foreground="White" FontSize="13"
                                         GroupName="MainTab" x:Name="TabSceneTree"
                                         Checked="TabSceneTree_Checked"/>
                            <RadioButton Content="命令" Margin="0,0,10,0"
                                         Foreground="White" FontSize="13"
                                         GroupName="MainTab" x:Name="TabCommands"
                                         Checked="TabCommands_Checked"/>
                            <RadioButton Content="模拟发包" Margin="0,0,10,0"
                                         Foreground="White" FontSize="13"
                                         GroupName="MainTab" x:Name="TabMock"
                                         Checked="TabMock_Checked"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Column="2">
                            <CheckBox Content="Log" IsChecked="{Binding ShowLogs}"
                                      Foreground="#AAA" FontSize="11" Margin="0,0,10,0"
                                      VerticalAlignment="Center"/>
                            <CheckBox Content="Warn" IsChecked="{Binding ShowWarnings}"
                                      Foreground="#FFC107" FontSize="11" Margin="0,0,10,0"
                                      VerticalAlignment="Center"/>
                            <CheckBox Content="Error" IsChecked="{Binding ShowErrors}"
                                      Foreground="#FF5252" FontSize="11" Margin="0,0,10,0"
                                      VerticalAlignment="Center"/>
                            <TextBox Text="{Binding LogFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="150" Style="{StaticResource ModernTextBox}"
                                     FontSize="12"/>
                        <Button Content="复制全部" Command="{Binding CopyLogsCommand}"
                                Style="{StaticResource ActionButton}" FontSize="11" Width="65" Margin="4,0"/>
                        <Button Content="保存日志" Command="{Binding SaveLogsCommand}"
                                Style="{StaticResource ActionButton}" FontSize="11" Width="65" Margin="4,0"/>
                        <Button Content="清除" Command="{Binding ClearLogsCommand}"
                                Style="{StaticResource ActionButton}" FontSize="11" Width="50"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 内容区域 -->
                <Grid Grid.Row="1">
                    <!-- 日志视图 - 单一文本框，支持任意跨行选取 -->
                    <TextBox x:Name="LogTextBox"
                             Text="{Binding LogDisplayText, Mode=OneWay}"
                             Style="{StaticResource LogTextBox}"
                             FontSize="12" Padding="8"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             Visibility="Visible"/>

                    <!-- 场景树视图 -->
                    <Border x:Name="SceneTreePanel" Background="#252526" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6">
                                <Button Content="刷新场景树" Command="{Binding RequestSceneTreeCommand}"
                                        Style="{StaticResource ActionButton}" FontSize="11" Width="90"/>
                            </StackPanel>

                            <TreeView x:Name="SceneTreeView" Grid.Row="1"
                                      Background="Transparent" BorderThickness="0"
                                      Margin="4,0" FontSize="12">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="Foreground" Value="#CCC"/>
                                        <Setter Property="IsExpanded" Value="False"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </Grid>
                    </Border>

                    <!-- 命令控制台 -->
                    <Grid x:Name="CommandsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 快捷指令按钮 -->
                        <WrapPanel Grid.Row="0" Margin="8,6">
                            <Button Content="🏓 Ping" Command="{Binding PingDeviceCommand}"
                                    Style="{StaticResource ActionButton}" Width="70"/>
                            <Button Content="🌲 场景树" Command="{Binding RequestSceneTreeCommand}"
                                    Style="{StaticResource ActionButton}" Width="75"/>
                            <Button Content="📋 日志" Command="{Binding RequestLogsCommand}"
                                    Style="{StaticResource ActionButton}" Width="65"/>
                            <Button Content="📷 截图" Command="{Binding RequestScreenshotCommand}"
                                    Style="{StaticResource ActionButton}" Width="65"/>
                            <Button Content="{Binding RecordButtonContent}"
                                    Command="{Binding RecordVideoCommand}" Width="75">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource ActionButton}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecordingForSelectedDevice}" Value="True">
                                                <Setter Property="Background" Value="#FF5252"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="🗑 清缓存" Command="{Binding ClearCacheCommand}"
                                    Style="{StaticResource ActionButton}" Width="75"/>
                            <Button Content="📁 请求文件" Command="{Binding SendFileRequestCommand}"
                                    Style="{StaticResource ActionButton}" Width="80"/>
                            <Button Content="🔄 重启游戏" Command="{Binding RestartGameCommand}"
                                    Style="{StaticResource ActionButton}" Width="85"
                                    Background="#E65100" Foreground="White" BorderThickness="0"/>
                            <Button Content="🔥 热更新" Command="{Binding HotUpdateCommand}"
                                    Style="{StaticResource ActionButton}" Width="80"
                                    Background="#BF360C" Foreground="White" BorderThickness="0"/>
                        </WrapPanel>

                        <!-- 自定义指令 -->
                        <Grid Grid.Row="1" Margin="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="自定义指令:" VerticalAlignment="Center"
                                       FontSize="13" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"/>
                            <TextBox Grid.Column="2" Text="{Binding CommandParameters, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" Margin="4,0"/>
                            <Button Grid.Column="3" Content="发送" Command="{Binding SendCommandCommand}"
                                    Background="#0078D4" Foreground="White" BorderThickness="0"
                                    Style="{StaticResource ActionButton}" Width="60"/>
                        </Grid>

                        <!-- Server log -->
                        <Border Grid.Row="2" Margin="8,4,8,8" Background="#1A1A1A"
                                BorderBrush="#333" BorderThickness="1" CornerRadius="3">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Background="#232323">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="命令日志" Foreground="#AAA" FontSize="12"
                                               VerticalAlignment="Center" Margin="8,4"/>
                                    <Button Grid.Column="1" Content="清空" HorizontalAlignment="Right"
                                            Command="{Binding ClearServerLogCommand}"
                                            Style="{StaticResource ActionButton}" FontSize="11"
                                            Width="50" Margin="8,4"/>
                                </Grid>
                                <TextBox Text="{Binding ServerLogText}" Style="{StaticResource LogTextBox}"
                                         FontSize="11" Padding="8" TextWrapping="Wrap"
                                         BorderThickness="0" Background="Transparent"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- 模拟服务器发包 -->
                    <Grid x:Name="MockPanel" Visibility="Collapsed">
                        <views:MockServerView x:Name="MockServerView"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== 底部状态栏 ==================== -->
        <Border Grid.Row="2" Background="#007ACC" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock FontSize="11" Foreground="White"
                           VerticalAlignment="Center" FontWeight="SemiBold">
                    <Run Text="Remote Debug Server v"/>
                    <Run Text="{Binding AppVersion, Mode=OneWay}"/>
                </TextBlock>
                <Border Grid.Column="1" Margin="12,0,12,0" Width="1" Background="#5AB4FF"/>
                <TextBlock Grid.Column="2" FontSize="11" Foreground="White"
                           VerticalAlignment="Center">
                    <Run Text="设备数: "/>
                    <Run Text="{Binding Devices.Count, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=" · 已选: "/>
                    <Run Text="{Binding SelectedDevice.Alias, TargetNullValue=-, Mode=OneWay}"
                         FontWeight="Bold"/>
                </TextBlock>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📂 接收文件" Command="{Binding OpenFileDirectoryCommand}"
                            Background="Transparent" Foreground="White" BorderThickness="1"
                            BorderBrush="#5AB4FF" FontSize="11" Padding="8,2" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
